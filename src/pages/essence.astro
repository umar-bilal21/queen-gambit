---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Descent from '../components/Descent.astro';
import EssenceRoom from '../components/EssenceRoom.astro';
import Enter from '../components/Enter.astro';
import Footer from '../components/Footer.astro';

import { site } from '../content/site';
import { images } from '../content/images';
---

<Base
  title={site.essence.meta.title}
  description={site.essence.meta.description}
  skipTarget="page-hero"
>
  <Header variant="page" condensed />

  <main id="main">
    <PageHero
      eyebrow={site.essence.hero.eyebrow}
      title={site.essence.hero.title}
      subtitle={site.essence.hero.subtitle}
      photo={images.pageHero.essence}
    />

    {/*
      The rooms sit on the same underwater ground the homepage descends
      through, so the inner page reads as part of the same site rather than a
      flat navy slab beside it.
    */}
    <Descent photo={images.descent}>
      <div class="essence">
        {site.essence.rooms.map((room, index) => (
          <EssenceRoom room={room} photos={images.essence[index].photos} index={index} />
        ))}
      </div>
    </Descent>

    <Enter
      left={images.enter.left}
      right={images.enter.right}
      title={site.essence.cta.title}
      subtitle={site.essence.cta.subtitle}
      label={site.essence.cta.label}
    />
  </main>

  <Footer photo={images.poolToOcean} />
</Base>

<style>
  .essence {
    color: var(--cream);
  }

  .essence :global(.room) {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* A hairline between the two experiences, in the same gold as the framing. */
  .essence :global(.room + .room) {
    border-block-start: 1px solid color-mix(in srgb, var(--gold) 24%, transparent);
  }
</style>
