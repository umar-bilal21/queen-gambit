---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import Masterwork from '../components/Masterwork.astro';
import Descent from '../components/Descent.astro';
import Rooms from '../components/Rooms.astro';
import Beliefs from '../components/Beliefs.astro';
import Return from '../components/Return.astro';
import Gallery from '../components/Gallery.astro';
import Manifesto from '../components/Manifesto.astro';
import Enter from '../components/Enter.astro';
import Footer from '../components/Footer.astro';
import { images } from '../content/images';

/**
 * The homepage. Sections in document order: Intro, Hero, Story, Masterwork,
 * Rooms, Beliefs, Gallery, Enter, Footer.
 *
 * The page decides which photograph goes where; each section decides how to
 * render it. That split keeps image sizing next to the layout that determines
 * it, and keeps this file readable as a table of contents.
 */
---

<Base>
  <Intro />
  <Header />

  <main id="main">
    <Hero photo={images.hero} />
    <Story />
    <Masterwork photos={images.masterwork} />
    {/*
      Rooms and Beliefs share one fixed underwater ground so scrolling between
      them never crosses a seam. The wrapper exists only to own that ground.
    */}
    <Descent photo={images.descent}>
      <Rooms photos={images.rooms} />
      <Beliefs photos={images.beliefRows} />
    </Descent>

    <Return />
    <Gallery photos={images.gallery} />
    <Manifesto />
    <Enter left={images.enter.left} right={images.enter.right} />
  </main>

  <Footer photo={images.poolToOcean} />
</Base>
