---
import { getImage } from 'astro:assets';

/*
 * Imported rather than hard-coded so the preload points at the same hashed file
 * the stylesheet asks for. A literal path would go stale the moment the build
 * fingerprints the font, and would break outright under a base path.
 */
import newsreaderUrl from '../assets/fonts/newsreader-latin.woff2?url';
import instrumentUrl from '../assets/fonts/instrument-sans-latin.woff2?url';

import { site } from '../content/site';
import { images, HERO_IMAGE } from '../content/images';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.meta.title, description = site.meta.description } = Astro.props;

/*
 * The Hero photograph is the page's largest contentful paint, and the Intro
 * lifts to reveal it about three and a half seconds in — a reveal that lands
 * on an empty frame is the one failure the whole opening cannot survive.
 *
 * Generated here with exactly the options the Hero section renders with, so
 * the preload and the <img> resolve to the same files rather than fetching two
 * different versions of the same photograph.
 */
const heroImage = await getImage({
  src: images.hero.src,
  widths: [...HERO_IMAGE.widths],
  sizes: HERO_IMAGE.sizes,
  quality: HERO_IMAGE.quality,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b1e30" />
    <link rel="canonical" href={Astro.site?.href ?? '/'} />

    {/*
      The Intro opens on type, so both faces must be there before it plays —
      a font swapping mid-timeline would break the one moment that has to look
      composed.
    */}
    <link
      rel="preload"
      href={newsreaderUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={instrumentUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      as="image"
      href={heroImage.src}
      imagesrcset={heroImage.srcSet.attribute}
      imagesizes={HERO_IMAGE.sizes}
      fetchpriority="high"
    />
  </head>
  <body>
    <a class="u-skip-link" href="#hero">Skip to content</a>
    <slot />

    {/*
      The single client island. Everything that ships JavaScript starts here;
      no other component has a script tag.
    */}
    <script>
      import '../motion/main';
    </script>
  </body>
</html>
