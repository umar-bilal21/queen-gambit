---
import { site } from '../content/site';
import QueenSilhouette from './QueenSilhouette.astro';
import Divider from './ornament/Divider.astro';

/**
 * The arrival.
 *
 * A fixed ~3.5s timeline over deep navy — art direction, not instrumentation.
 * There is no progress bar and no percentage because there is no honest
 * progress to report: the page is interactive in well under a second, so a bar
 * would either flash past or lie (ADR 0003).
 *
 * It is rendered as real markup rather than injected by script so that a
 * visitor with JavaScript disabled sees the Castle rather than a blank navy
 * screen — the `data-intro` element is removed by the motion island once its
 * timeline finishes, and CSS alone dismisses it if the island never boots.
 */
---

<div class="intro" data-intro role="presentation">
  <div class="intro__stage">
    <QueenSilhouette class="intro__queen" />
    <div class="intro__words" data-intro-line>
      <p class="intro__line u-eyebrow u-eyebrow--wide">{site.intro.line}</p>
      <Divider piece="queen" width="min(80vw, 18rem)" class="intro__rule" />
    </div>
  </div>

  <button class="intro__skip u-eyebrow" type="button" data-intro-skip>
    {site.intro.skipLabel}
  </button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    /* The deepest ground on the site. Everything after this is a lightening. */
    background: var(--navy-abyss);
    color: var(--cream);
  }

  .intro[data-intro-state='done'] {
    display: none;
  }

  .intro__stage {
    display: grid;
    justify-items: center;
    gap: clamp(1.75rem, 5vh, 3.25rem);
    padding-inline: var(--gutter);
  }

  .intro__words {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 2.5vh, 1.75rem);
  }

  .intro__line {
    max-width: 32ch;
    text-align: center;
    line-height: 1.9;
    color: color-mix(in srgb, var(--cream) 88%, transparent);
  }

  .intro__rule {
    color: var(--gold);
  }

  .intro__skip {
    position: absolute;
    inset-block-end: clamp(1.5rem, 5vh, 3rem);
    inset-inline-end: var(--gutter);
    padding: 0.5rem 0.25rem;
    color: color-mix(in srgb, var(--cream) 60%, transparent);
    transition: color 0.3s var(--ease-out);
  }

  .intro__skip:hover {
    color: var(--cream);
  }

  /**
   * Two fallbacks, both deliberate.
   *
   * Reduced motion: the Intro never appears. A visitor who has asked the system
   * to avoid motion should not be held for three and a half seconds by an
   * animation, and there is nothing in it they need.
   *
   * No working island: if the bundle never loads, nothing would ever remove
   * this overlay and the Castle would be unreachable behind a navy screen. So
   * the overlay dismisses itself on a timer by default, and the island's first
   * act is to set `data-intro-state="running"`, which cancels it and hands
   * control to the timeline.
   */
  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro {
      animation: intro-failsafe 0.5s var(--ease-out) 3.2s forwards;
    }

    .intro[data-intro-state='running'] {
      animation: none;
    }
  }

  @keyframes intro-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
