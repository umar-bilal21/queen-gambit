---
import { site, contactHref } from '../content/site';
import Monogram from './Monogram.astro';

/**
 * Transparent over the Hero, condensing to solid navy once the visitor scrolls
 * past it. The condensing itself is driven by the motion island.
 *
 * Every link resolves to a section that exists on this page. There are no inner
 * pages, and a dead link in a pitch is a leak you then have to explain.
 */
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="header__mark" href="#hero" aria-label={`${site.name} — home`}>
      <Monogram size="2.1rem" label={null} />
    </a>

    <nav class="header__nav" aria-label="Sections">
      <ul class="header__list">
        {
          site.nav.map((item) => (
            <li>
              <a class="header__link u-eyebrow" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header__contact u-eyebrow" href={contactHref}>Contact</a>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="header-menu"
      aria-label="Menu"
      data-menu-toggle
    >
      {/*
        The accessible name is on the button itself, not a visually-hidden
        child. A child <span> would be the first span in here and would steal
        `:first-of-type` from the bars, leaving one of them unrotated — the
        close icon renders as a "not equals" sign rather than a cross.
      */}
      <span class="header__bar" aria-hidden="true"></span>
      <span class="header__bar" aria-hidden="true"></span>
    </button>
  </div>

  <div class="header__menu" id="header-menu" data-menu hidden>
    <ul class="header__menu-list">
      {
        site.nav.map((item) => (
          <li>
            <a class="header__menu-link" href={item.href} data-menu-link>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="header__menu-link" href={contactHref} data-menu-link>
          Contact
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    color: var(--cream);
    transition:
      background-color 0.4s var(--ease-out),
      backdrop-filter 0.4s var(--ease-out),
      padding 0.4s var(--ease-out);
  }

  /* Set by the motion island once the Hero has passed. */
  .header[data-condensed='true'] {
    background: color-mix(in srgb, var(--navy-deep) 94%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--gold) 30%, transparent);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding: clamp(0.9rem, 2vw, 1.6rem) var(--gutter);
  }

  .header__mark {
    display: flex;
    flex: none;
    margin-inline-end: auto;
    color: var(--gold-light);
  }

  .header__nav {
    display: none;
  }

  .header__list {
    display: flex;
    gap: clamp(1.5rem, 3vw, 3rem);
    list-style: none;
    padding: 0;
  }

  .header__link,
  .header__contact {
    position: relative;
    padding-block: 0.35rem;
    opacity: 0.85;
    transition: opacity 0.3s var(--ease-out);
  }

  .header__link::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }

  .header__link:hover,
  .header__contact:hover {
    opacity: 1;
  }

  .header__link:hover::after {
    transform: scaleX(1);
  }

  .header__contact {
    display: none;
  }

  /* Small-screen menu ------------------------------------------------------ */

  /*
   * The bars are positioned against a fixed box rather than laid out by a grid
   * gap. Rotating grid children means each bar turns about its own row's
   * centre, and the two strokes cross off-centre — it reads as a slash with a
   * stray bar rather than a cross.
   */
  .header__toggle {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
  }

  .header__bar {
    position: absolute;
    inset-inline: 2px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.35s var(--ease-out);
  }

  .header__bar:first-of-type {
    top: 11px;
  }

  .header__bar:last-of-type {
    top: 18px;
  }

  .header__toggle[aria-expanded='true'] .header__bar:first-of-type {
    transform: translateY(3.5px) rotate(45deg);
  }

  .header__toggle[aria-expanded='true'] .header__bar:last-of-type {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .header__menu {
    background: var(--navy);
    border-block-start: 1px solid color-mix(in srgb, var(--cream) 15%, transparent);
  }

  .header__menu[hidden] {
    display: none;
  }

  .header__menu-list {
    display: grid;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: var(--space-m) var(--gutter) var(--space-l);
  }

  .header__menu-link {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
  }

  @media (min-width: 56rem) {
    .header__nav,
    .header__contact {
      display: block;
    }

    .header__mark {
      margin-inline-end: 0;
    }

    .header__nav {
      margin-inline: auto;
    }

    .header__toggle,
    .header__menu {
      display: none;
    }
  }
</style>
