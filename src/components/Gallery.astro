---
import { Image } from 'astro:assets';

import { site } from '../content/site';
import type { Photo } from '../content/images';

/**
 * The property, seen properly: a display title, then the photography travelling
 * horizontally as the visitor scrolls vertically.
 *
 * The rail is a real overflow-scroll container rather than a transformed strip.
 * That buys three things at once: it is swipeable on touch with no code, it is
 * keyboard-scrollable, and if the motion island never boots the section is
 * still a perfectly usable horizontal scroller instead of a frozen row. The
 * island scrubs `scrollLeft` on top of that rather than replacing it.
 */

interface Props {
  photos: readonly Photo[];
}

const { photos } = Astro.props;
---

<section
  class="gallery u-on-navy"
  id="gallery"
  aria-labelledby="gallery-title"
  data-gallery
>
  <div class="gallery__head u-container">
    <p class="u-eyebrow u-eyebrow--wide gallery__eyebrow" data-reveal>{site.gallery.eyebrow}</p>
    <h2 class="gallery__title" id="gallery-title" data-reveal-heading>{site.gallery.title}</h2>
  </div>

  <ul class="gallery__rail" data-gallery-rail tabindex="0" aria-label="Castle photographs">
    {
      photos.map((image) => (
        <li class="gallery__item u-cover">
          <Image
            src={image.src}
            alt={image.alt}
            widths={[600, 900, 1400]}
            sizes="(min-width: 52rem) 52vw, 90vw"
            loading="lazy"
            quality={80}
          />
        </li>
      ))
    }
    {/*
      A second pass of the same photographs, so the rail can wrap without a
      visible jump: when the travel passes the halfway mark it is rewound by
      exactly one set and the visitor sees no seam.

      Hidden from assistive technology and from the tab order — it is the same
      eight pictures, and announcing them twice would be a bug rather than a
      feature.
    */}
    {
      photos.map((image) => (
        <li class="gallery__item u-cover" aria-hidden="true" data-gallery-clone>
          <Image
            src={image.src}
            alt=""
            widths={[600, 900, 1400]}
            sizes="(min-width: 52rem) 52vw, 90vw"
            loading="lazy"
            quality={80}
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .gallery {
    /* Opens and closes on the same step as every other section. */
    padding-block: var(--space-2xl);
    overflow: clip;
  }

  .gallery__head {
    display: grid;
    gap: var(--space-s);
    margin-block-end: var(--space-l);
  }

  .gallery__eyebrow {
    color: var(--gold-light);
  }

  .gallery__title {
    font-size: var(--step-4);
  }

  .gallery__rail {
    display: flex;
    cursor: grab;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding-inline: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .gallery__rail::-webkit-scrollbar {
    display: none;
  }

  /*
   * Wide landscape frames, as in the reference. The rail reads as a strip of
   * views along a coast rather than a row of cards, and a wider frame is also
   * what this photography wants — almost all of it is horizon.
   */
  .gallery__item {
    flex: none;
    width: clamp(20rem, 52vw, 46rem);
    aspect-ratio: 16 / 9;
    overflow: clip;
    background: color-mix(in srgb, var(--cream) 8%, transparent);
  }

  .gallery__rail[data-dragging='true'] {
    cursor: grabbing;
    /* Stops the browser turning a horizontal drag into a text selection or an
       image drag halfway through the gesture. */
    user-select: none;
  }

  .gallery__rail[data-dragging='true'] :global(img) {
    pointer-events: none;
  }

  .gallery__item :global(img) {
    transition: transform 1.2s var(--ease-out);
  }

  .gallery__item:hover :global(img) {
    transform: scale(1.04);
  }

  </style>
