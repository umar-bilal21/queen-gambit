---
import { Image } from 'astro:assets';

import { site } from '../content/site';
import type { Photo } from '../content/images';
import Divider from './ornament/Divider.astro';

/**
 * What the marine work in the building means — three full-width bands that
 * stack over one another as the visitor scrolls.
 *
 * The bands are the client's original instruction and the arrangement they
 * preferred. An intermediate version turned them into flip cards to save
 * height; the client rejected it, and they were right — three cards in a row is
 * a features grid, and this copy is three consecutive thoughts rather than
 * three options.
 *
 * What the cards were solving was the height, and the stack solves it properly:
 * each band is sticky at the top of the viewport, so the next one climbs over
 * the last rather than pushing it down the page. Three screens of content
 * occupy one screen at a time, and the movement is the point rather than a
 * side effect — this is the behaviour of the reference the client pointed at.
 *
 * Every band has to be fully opaque, or the band beneath shows through as it is
 * covered. That is why each carries its own veil rather than relying on a
 * shared ground.
 */
interface Props {
  /** In the same order as the blocks. */
  photos: readonly Photo[];
}

const { photos } = Astro.props;
---

<section class="masterwork" id="masterwork" aria-labelledby="masterwork-title" data-stack>
  {
    site.masterwork.blocks.map((block, index) => (
      <div class="masterwork__band u-on-navy" data-stack-band>
        <div class="masterwork__media u-cover" aria-hidden="true">
          <Image
            src={photos[index].src}
            alt=""
            widths={[1200, 1800, 2400]}
            sizes="100vw"
            loading="lazy"
            quality={76}
          />
        </div>
        <div class="masterwork__veil" aria-hidden="true" />

        <div class="masterwork__inner u-container">
          <h2
            class="masterwork__title"
            id={index === 0 ? 'masterwork-title' : undefined}
          >
            {block.title}
          </h2>
          <Divider piece={index === 1 ? 'queen' : 'pawn'} width="min(70vw, 14rem)" />
          <p class="masterwork__body">{block.body}</p>

          {
            index === site.masterwork.blocks.length - 1 && (
              <a class="masterwork__cta u-eyebrow" href={site.masterwork.ctaHref}>
                {site.masterwork.cta}
              </a>
            )
          }
        </div>
      </div>
    ))
  }
</section>

<style>
  .masterwork {
    position: relative;
  }

  .masterwork__band {
    position: sticky;
    inset-block-start: 0;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding-block: var(--space-xl);
    overflow: clip;
    isolation: isolate;
    text-align: center;
  }

  .masterwork__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /**
   * Opaque enough that the band underneath never shows through as this one
   * climbs over it, and heavy enough that body copy sits on a real ground
   * rather than a tint — one of the three photographs is a sunrise that is
   * already dark, so the shadow on the type does the rest of the work.
   */
  .masterwork__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--navy-deep) 76%, transparent),
      color-mix(in srgb, var(--navy-abyss) 68%, transparent)
    );
  }

  .masterwork__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
    max-width: 60rem;
  }

  .masterwork__title {
    font-size: var(--step-4);
    text-shadow: 0 2px 26px color-mix(in srgb, var(--navy-abyss) 72%, transparent);
  }

  .masterwork__body {
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.65;
    color: color-mix(in srgb, var(--cream) 92%, transparent);
    text-shadow: 0 1px 18px color-mix(in srgb, var(--navy-abyss) 85%, transparent);
  }

  .masterwork__cta {
    margin-block-start: var(--space-m);
    padding: 1.05rem 2.6rem;
    color: var(--gold-light);
    border: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    transition:
      background-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }

  .masterwork__cta:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--navy-abyss);
  }

  /*
   * No stack without motion. Sticky stacking is movement by definition, and a
   * visitor who has asked for less of it should get three ordinary sections.
   */
  @media (prefers-reduced-motion: reduce) {
    .masterwork__band {
      position: static;
      min-height: auto;
      padding-block: var(--space-2xl);
    }
  }
</style>
