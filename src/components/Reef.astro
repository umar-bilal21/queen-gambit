---
import { site } from '../content/site';
import ReefArtwork from './ReefArtwork.astro';

/**
 * The ocean as artwork rather than photography: a cream field carrying coral,
 * seaweed and the ceramic turtles the copy names.
 *
 * The top edge is a straight line. The client's earlier mockup had a wavy
 * divider here and asked explicitly for it to go.
 */
---

<section class="reef u-on-cream" id="reef" aria-labelledby="reef-title">
  <div class="reef__art reef__art--left" aria-hidden="true">
    <ReefArtwork side="left" />
  </div>
  <div class="reef__art reef__art--right" aria-hidden="true">
    <ReefArtwork side="right" />
  </div>

  <div class="reef__inner u-container">
    <h2 class="u-visually-hidden" id="reef-title">Inside the Castle</h2>
    <p class="reef__body">{site.reef.body}</p>
  </div>
</section>

<style>
  .reef {
    position: relative;
    /* Straight top edge — no wavy divider. */
    padding-block: var(--space-2xl);
    overflow: clip;
    isolation: isolate;
  }

  .reef__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .reef__body {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.55;
    max-width: 34ch;
    text-wrap: balance;
  }

  .reef__art {
    position: absolute;
    inset-block-end: 0;
    z-index: -1;
    width: clamp(10rem, 24vw, 20rem);
    height: min(100%, 40rem);
    pointer-events: none;
  }

  .reef__art--left {
    inset-inline-start: 0;
  }

  .reef__art--right {
    inset-inline-end: 0;
  }

  /* On a phone the artwork would sit behind the copy and cost contrast, so it
     retreats to a faint band at the foot of the section instead. */
  @media (max-width: 52rem) {
    .reef__art {
      width: 42vw;
      height: 12rem;
      opacity: 0.55;
    }

    .reef {
      padding-block-end: calc(var(--space-2xl) + 6rem);
    }
  }
</style>
