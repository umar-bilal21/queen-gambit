---
import { Image } from 'astro:assets';

import { site } from '../content/site';
import type { Photo } from '../content/images';

/**
 * Five convictions, each a wide band that fills with photography as you reach
 * it.
 *
 * The composition follows the client's reference closely, and two things in it
 * matter more than they look:
 *
 * 1. The photograph belongs to the *row*, clipped inside its band — not to the
 *    section. A single backdrop behind all five rows reads as one dim image the
 *    page happens to be sitting on; a photograph bounded by the row reads as
 *    that conviction having a place attached to it, and the hard band edges are
 *    most of what makes the effect land.
 * 2. The title is the largest thing in the row by a wide margin. At label size
 *    the row is a list item; at display size it is a statement, which is what
 *    the section is for.
 *
 * Scroll-driven first, hover second. The brief said "when you hover over it
 * photo appear as you scroll down", which is two triggers in one sentence; the
 * resolution is that scroll position sets the Active row so the section
 * performs itself for someone who never moves their mouse — which is exactly
 * what the client will do — and hover takes over where a fine pointer exists.
 *
 * The decision itself lives in `activeBeliefIndex` in the motion module, where
 * its boundary conditions are tested. Nothing here reimplements it.
 *
 * No arrow affordance: the client asked for the reference's arrow to go.
 */
interface Props {
  /** In the same order as the Beliefs. */
  photos: readonly Photo[];
}

const { photos } = Astro.props;

/*
 * The reference sets the heading over two lines with the second muted. Split
 * here rather than in the content module: it is a typographic decision about
 * this composition, not a change to what the sentence says.
 */
const [titleLead, ...titleRest] = site.beliefs.title.split(' BUILT ');
const titleLines = [`${titleLead} BUILT`, titleRest.join(' BUILT ')];
---

<section class="beliefs u-on-navy" id="beliefs" aria-labelledby="beliefs-title" data-beliefs>
  <div class="beliefs__head u-container">
    <p class="u-eyebrow u-eyebrow--wide beliefs__eyebrow" data-reveal>{site.beliefs.eyebrow}</p>

    <div class="beliefs__headline">
      <h2 class="beliefs__title" id="beliefs-title" data-reveal-heading>
        <span>{titleLines[0]}</span>{' '}
        <span class="beliefs__title-muted">{titleLines[1]}</span>
      </h2>
      <p class="beliefs__intro" data-reveal data-reveal-delay="0.15">{site.beliefs.intro}</p>
    </div>
  </div>

  <ol class="beliefs__list" data-beliefs-list>
    {
      site.beliefs.items.map((belief, index) => (
        <li class="beliefs__row" data-belief data-active={index === 0 ? 'true' : 'false'}>
          <div class="beliefs__photo u-cover" aria-hidden="true">
            <Image
              src={photos[index].src}
              alt=""
              widths={[900, 1400, 1920]}
              sizes="100vw"
              loading="lazy"
              quality={74}
            />
          </div>
          <div class="beliefs__veil" aria-hidden="true" />

          <div class="beliefs__row-inner u-container">
            <span class="beliefs__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <p class="beliefs__row-body">{belief.body}</p>
            <h3 class="beliefs__row-title">{belief.title}</h3>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .beliefs {
    padding-block: var(--space-2xl) 0;
    overflow: clip;
  }

  /* Heading ---------------------------------------------------------------- */

  .beliefs__head {
    display: grid;
    gap: var(--space-m);
    margin-block-end: var(--space-xl);
  }

  .beliefs__eyebrow {
    color: var(--aqua);
  }

  .beliefs__title {
    font-size: var(--step-3);
    font-weight: 300;
    letter-spacing: 0.005em;
    line-height: 1.14;
    text-wrap: balance;
  }

  /* The second line drops back, as in the reference — the phrase reads as one
     thought arriving in two beats rather than as a solid block. */
  .beliefs__title-muted {
    color: color-mix(in srgb, var(--cream) 45%, transparent);
  }

  .beliefs__intro {
    max-width: var(--measure);
    margin-block-start: var(--space-s);
    color: color-mix(in srgb, var(--cream) 78%, transparent);
  }

  @media (min-width: 60rem) {
    .beliefs__head {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
      align-items: start;
      gap: clamp(2rem, 6vw, 6rem);
    }
  }

  /* Rows ------------------------------------------------------------------- */

  .beliefs__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid color-mix(in srgb, var(--cream) 16%, transparent);
  }

  .beliefs__row {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(9rem, 17vw, 14rem);
    padding-block: var(--space-m);
    border-block-end: 1px solid color-mix(in srgb, var(--cream) 16%, transparent);
    overflow: clip;
    isolation: isolate;
  }

  /* The photograph is bounded by the row. That hard edge is the effect. */
  .beliefs__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 0.75s var(--ease-out),
      transform 1.4s var(--ease-out);
  }

  .beliefs__row[data-active='true'] .beliefs__photo {
    opacity: 1;
    transform: scale(1);
  }

  /**
   * Weighted to the left, where the number and paragraph sit, and lighter under
   * the title on the right. A flat wash heavy enough for small body copy would
   * have flattened the photograph out of existence.
   */
  .beliefs__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--navy) 92%, transparent) 0%,
      color-mix(in srgb, var(--navy) 74%, transparent) 40%,
      color-mix(in srgb, var(--navy) 40%, transparent) 100%
    );
  }

  .beliefs__row-inner {
    display: grid;
    gap: var(--space-xs);
  }

  .beliefs__index {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-caps);
    color: var(--aqua);
  }

  /*
   * Set caps rather than lowercase, so it takes a touch of positive tracking —
   * a serif set in capitals without it reads as cramped.
   */
  .beliefs__row-title {
    font-size: clamp(1.5rem, 4.8vw, 3.3rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0.012em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .beliefs__row-body {
    max-width: 38ch;
    font-size: var(--step--1);
    line-height: 1.65;
    color: color-mix(in srgb, var(--cream) 82%, transparent);
    opacity: 0.45;
    transition: opacity 0.5s var(--ease-out);
  }

  .beliefs__row[data-active='true'] .beliefs__row-body {
    opacity: 1;
  }

  @media (min-width: 60rem) {
    .beliefs__row-inner {
      grid-template-columns: 3.5rem minmax(0, 34ch) minmax(0, 1fr);
      align-items: center;
      gap: clamp(1.5rem, 4vw, 4rem);
    }

    .beliefs__row-title {
      text-align: right;
    }
  }

  /**
   * Without the island — no JavaScript, or reduced motion — every row reads at
   * full strength rather than four of five looking half-lit. The photographs
   * stay hidden: with nothing driving the Active state they would all show at
   * once, five images stacked in five bands with no relationship to what is
   * being read.
   */
  @media (prefers-reduced-motion: reduce) {
    .beliefs__row-body {
      opacity: 1;
    }
  }
</style>
