---
/**
 * Land tortoises among reeds — the line work for the manifesto's cream ground.
 *
 * Deliberately not the Story's sea turtles. The client asked for "turtles, not
 * sea turtles", and when the difference was put to them they confirmed they
 * meant the land animal. So this is a tortoise: a high domed carapace rather
 * than a flat hydrodynamic shell, stumpy pillar legs rather than paddle
 * flippers, and a neck that extends forward from the shell rather than a head
 * tucked against it.
 *
 * Two creatures in two cream panels of an ocean-themed site is a strange note,
 * and it was flagged as such before building. It is the client's call and it is
 * recorded in the spec.
 *
 * Same stroke weight and same strokable construction as everything else, so it
 * draws itself on and belongs to the same hand.
 */
interface Props {
  side: 'left' | 'right';
  class?: string;
}

const { side, class: className } = Astro.props;
---

<svg
  class:list={['tortoise-art', `tortoise-art--${side}`, className]}
  viewBox="0 0 220 400"
  fill="none"
  role="presentation"
  aria-hidden="true"
  preserveAspectRatio="xMidYMax meet"
  data-reef-art
>
  <g
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {/* Reeds, standing rather than swaying — this is land. */}
    <g data-reef-kelp style="transform-origin: 46px 386px">
      <path d="M40 386 C44 340 38 300 44 262" data-reef-part></path>
      <path d="M56 386 C58 348 52 318 58 292" data-reef-part></path>
      <path d="M28 386 C32 356 27 332 31 312" data-reef-part></path>
      <path d="M44 262 L40 246 M44 262 L50 248" data-reef-part></path>
      <path d="M58 292 L54 278 M58 292 L64 280" data-reef-part></path>
    </g>

    <g data-reef-kelp style="transform-origin: 182px 386px">
      <path d="M176 386 C180 350 174 320 180 292" data-reef-part></path>
      <path d="M192 386 C194 356 189 334 194 314" data-reef-part></path>
      <path d="M180 292 L176 277 M180 292 L186 279" data-reef-part></path>
    </g>

    {/* Ground line. */}
    <path d="M0 385 C40 379 78 383 118 379 C158 375 190 381 220 377" data-reef-part
    ></path>

    {/*
      The tortoise, in profile. A domed shell, a neck reaching forward, four
      pillar legs. Drawn side-on rather than from above: a tortoise seen from
      above is very nearly a turtle seen from above, and the whole point of this
      artwork is that it is not one.
    */}
    <g data-reef-turtle><g transform="translate(104 300)">
      {/* Carapace: high and domed. */}
      <path d="M-46 8 C-46 -26 -24 -44 0 -44 C24 -44 46 -26 46 8" data-reef-part
      ></path>
      <path d="M-46 8 C-30 16 30 16 46 8" data-reef-part></path>

      {/* Scutes across the dome. */}
      <path d="M-24 -38 C-26 -20 -26 -4 -24 10" data-reef-part></path>
      <path d="M0 -44 C-2 -24 -2 -6 0 12" data-reef-part></path>
      <path d="M24 -38 C26 -20 26 -4 24 10" data-reef-part></path>
      <path d="M-42 -12 C-20 -6 20 -6 42 -12" data-reef-part></path>

      {/* Head and neck, reaching forward and slightly up. */}
      <path
        d="M-46 -2 C-58 -6 -68 -14 -70 -24 C-71 -31 -66 -35 -61 -33 C-56 -31 -55 -24 -57 -18"
        data-reef-part></path>
      <circle cx="-64" cy="-28" r="1.6" data-reef-part></circle>

      {/* Four pillar legs and a short tail. */}
      <path d="M-32 12 L-34 30 L-24 30 L-24 14" data-reef-part></path>
      <path d="M-6 15 L-8 32 L2 32 L2 16" data-reef-part></path>
      <path d="M22 14 L20 31 L30 31 L30 12" data-reef-part></path>
      <path d="M46 4 C52 8 54 14 51 18" data-reef-part></path>
    </g></g>

    {/* A second, smaller, further back. */}
    <g data-reef-turtle><g transform="translate(150 200) scale(0.5)">
      <path d="M-46 8 C-46 -26 -24 -44 0 -44 C24 -44 46 -26 46 8" data-reef-part
      ></path>
      <path d="M-46 8 C-30 16 30 16 46 8" data-reef-part></path>
      <path d="M0 -44 C-2 -24 -2 -6 0 12" data-reef-part></path>
      <path d="M-42 -12 C-20 -6 20 -6 42 -12" data-reef-part></path>
      <path
        d="M-46 -2 C-58 -6 -68 -14 -70 -24 C-71 -31 -66 -35 -61 -33 C-56 -31 -55 -24 -57 -18"
        data-reef-part></path>
      <path d="M-32 12 L-34 30 L-24 30 L-24 14" data-reef-part></path>
      <path d="M22 14 L20 31 L30 31 L30 12" data-reef-part></path>
    </g></g>
  </g>
</svg>

<style>
  .tortoise-art {
    width: 100%;
    height: 100%;
    color: color-mix(in srgb, var(--accent) 78%, transparent);
  }

  .tortoise-art--right {
    transform: scaleX(-1);
  }
</style>
