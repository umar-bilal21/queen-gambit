---
import { Image } from 'astro:assets';

import { site, contactHref } from '../content/site';
import type { Photo } from '../content/images';

/**
 * The close: two photographs combined into one full-bleed field, an invitation,
 * and a contact button that actually works.
 *
 * The button is a real mailto with the subject prefilled. A visitor who wants
 * to make contact should not have to hunt for an address, and a form here would
 * mean a backend and a spam problem in a pitch that has neither.
 */
interface Props {
  left: Photo;
  right: Photo;
}

const { left, right } = Astro.props;
---

<section class="enter" id="enter" aria-labelledby="enter-title">
  <div class="enter__media" aria-hidden="true">
    <div class="enter__pane enter__pane--left u-cover">
      <Image
        src={left.src}
        alt=""
        widths={[640, 1024, 1400]}
        sizes="60vw"
        loading="lazy"
        quality={78}
      />
    </div>
    <div class="enter__pane enter__pane--right u-cover">
      <Image
        src={right.src}
        alt=""
        widths={[640, 1024, 1400]}
        sizes="60vw"
        loading="lazy"
        quality={78}
      />
    </div>
    <div class="enter__scrim"></div>
  </div>

  <div class="enter__inner u-container">
    <h2 class="enter__title" id="enter-title" data-reveal-heading>{site.enter.title}</h2>
    <p class="enter__subtitle u-eyebrow" data-reveal data-reveal-delay="0.12">
      {site.enter.subtitle}
    </p>
    <a class="enter__cta u-eyebrow" href={contactHref} data-reveal data-reveal-delay="0.24">
      {site.enter.cta}
    </a>
  </div>
</section>

<style>
  .enter {
    position: relative;
    display: grid;
    place-items: center;
    min-height: min(68svh, 36rem);
    padding-block: var(--space-2xl);
    overflow: clip;
    background: var(--navy-deep);
    color: var(--cream);
    isolation: isolate;
    text-align: center;
  }

  .enter__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .enter__pane {
    position: absolute;
    inset-block: 0;
    overflow: clip;
  }

    /**
   * The two photographs must read as one field, not as a diptych with a seam.
   *
   * Feathering both inward edges does not work: across the overlap neither
   * pane is fully opaque, their opacities sum to less than one, and the
   * background shows through as a pale vertical band — the exact seam the
   * feathering was meant to remove. So the right photograph lies full-width
   * underneath, and only the left one is masked, dissolving into it.
   */
  .enter__pane--right {
    inset-inline: 0;
  }

  .enter__pane--left {
    inset-inline-start: 0;
    width: 62%;
    /* Above the full-width right pane, which is earlier in paint order, so the
       left photograph is the one that dissolves into the other. */
    z-index: 1;
    mask-image: linear-gradient(to right, black 55%, transparent 100%);
  }

  /**
   * Both available photographs are bright daylight with a great deal of sky,
   * and cream display type over sky is unreadable at any weight. Two layers
   * solve it: a flat wash that lowers the whole field, and a soft ellipse that
   * puts real ground behind the type block without flattening the corners of
   * the photograph.
   */
  .enter__scrim {
    position: absolute;
    inset: 0;
    /*
     * Positive, not negative. A negative z-index here would place the scrim
     * behind its sibling panes rather than over them — the whole `.enter__media`
     * layer is already behind the copy, so within it the scrim must sit on top.
     */
    z-index: 2;
    background:
      radial-gradient(
        ellipse 62% 50% at 50% 46%,
        color-mix(in srgb, var(--navy-deep) 72%, transparent) 0%,
        color-mix(in srgb, var(--navy-deep) 30%, transparent) 68%,
        transparent 100%
      ),
      color-mix(in srgb, var(--navy-deep) 58%, transparent);
  }

  .enter__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
  }

  .enter__title {
    font-size: var(--step-4);
    /* Cream display type over a bright sky needs more than a wash behind it. */
    text-shadow: 0 2px 24px color-mix(in srgb, var(--navy-deep) 85%, transparent);
  }

  .enter__subtitle {
    max-width: 42ch;
    color: var(--gold-light);
    text-shadow: 0 1px 16px color-mix(in srgb, var(--navy-deep) 80%, transparent);
  }

  .enter__cta {
    margin-block-start: var(--space-s);
    padding: 1.1rem 2.6rem;
    background: var(--gold);
    color: var(--navy-abyss);
    transition:
      background-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .enter__cta:hover {
    background: var(--gold-light);
    transform: translateY(-2px);
  }
</style>
