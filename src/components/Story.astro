---
import { site } from '../content/site';
import ReefArtwork from './ReefArtwork.astro';

/**
 * One cream beige section: the reef line work, and the Castle's opening passage.
 *
 * The passage is two paragraphs but one piece of text — both set the same, both
 * recolouring, so the effect runs straight through from the first word to the
 * last rather than stopping at a headline and handing over to body copy. That
 * is what the reference does, and it is what the client asked for.
 *
 * The recolour is bound to scroll position rather than played on a timer, so
 * scrolling back up runs it backwards and the effect is never spent.
 *
 * Splitting happens here at build time rather than in the browser. Doing it in
 * markup means the words are real text in the HTML — selectable, searchable,
 * and read in the right order by a screen reader — and it means the section
 * renders correctly at full contrast when the motion island never boots.
 *
 * Each word is wrapped, not each character: per-character recolouring reads as
 * a glitch at this size, and it multiplies the element count by five.
 *
 * The section's top edge is a straight line. The client's earlier mockup had a
 * wavy divider here and asked explicitly for it to go.
 */

const words = (text: string) => text.split(/\s+/).filter(Boolean);
---

<section class="story u-on-cream" id="story" aria-labelledby="story-title">
  <div class="story__art story__art--left" aria-hidden="true">
    <ReefArtwork side="left" />
  </div>
  <div class="story__art story__art--right" aria-hidden="true">
    <ReefArtwork side="right" />
  </div>

  <div class="story__inner u-container">
    <span class="story__mark" aria-hidden="true">✦</span>

    <div class="story__passage">
      {
        site.story.paragraphs.map((paragraph, index) => {
          const Tag = index === 0 ? 'h2' : 'p';
          return (
            <Tag class="story__para" id={index === 0 ? 'story-title' : undefined}>
              {words(paragraph).map((word) => (
                <>
                  <span class="story__word" data-story-word>
                    {word}
                  </span>{' '}
                </>
              ))}
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    /* Straight top edge — no wavy divider. */
    padding-block: var(--space-2xl);
    overflow: clip;
    isolation: isolate;
  }

  .story__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-l);
    max-width: 68rem;
    text-align: center;
  }

  .story__mark {
    font-size: var(--step-1);
    color: var(--aqua-deep);
  }

  /*
   * The measure is set in rem, not ch. This wrapper inherits the body's font
   * size rather than the passage's, so a ch-based measure here resolves
   * against ~1rem and squeezes the display text to three words a line.
   */
  .story__passage {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    max-width: min(100%, 44rem);
  }

  /*
   * Both paragraphs, identically set. The first is an h2 for the document
   * outline — it is the section's heading in structure — but nothing about its
   * appearance says so, because visually it is simply where the passage starts.
   */
  .story__para {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1.28;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  /**
   * The starting colour is full navy, not the faded aqua.
   *
   * That matters: if the island never boots, or the visitor has reduced motion
   * on, every word stays at full contrast and the passage is completely
   * legible. The animation's job is to fade words *away* behind the reader, not
   * to fade them in — so the accessible state is also the default state.
   */
  .story__word {
    color: var(--navy);
    transition: color 0.1s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .story__word {
      color: var(--navy) !important;
    }
  }

  .story__art {
    position: absolute;
    inset-block-end: 0;
    z-index: -1;
    width: clamp(10rem, 24vw, 20rem);
    height: min(100%, 40rem);
    pointer-events: none;
  }

  .story__art--left {
    inset-inline-start: 0;
  }

  .story__art--right {
    inset-inline-end: 0;
  }

  /* On a phone the artwork would sit behind the copy and cost contrast, so it
     retreats to a band at the foot of the section instead. */
  @media (max-width: 52rem) {
    .story {
      padding-block-end: calc(var(--space-2xl) + 7rem);
    }

    .story__art {
      width: 45vw;
      height: 13rem;
      opacity: 0.6;
    }
  }
</style>
