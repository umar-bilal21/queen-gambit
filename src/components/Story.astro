---
import { site } from '../content/site';
import ReefArtwork from './ReefArtwork.astro';

/**
 * One cream beige section: the reef line work, and the Castle's opening passage.
 *
 * The passage does not lay itself out down the page. It travels through a fixed
 * window while the section is held still, so a long piece of writing costs a
 * predictable amount of screen rather than however many lines it happens to
 * run to. Words fade from navy to aqua behind the reader as they go, and the
 * window's edges are masked so text arrives and leaves rather than being cut.
 *
 * Two paragraphs, but one piece of text: both set identically, both
 * recolouring, so the effect runs unbroken from the first word to the last.
 *
 * Splitting happens here at build time rather than in the browser. Doing it in
 * markup means the words are real text in the HTML — selectable, searchable,
 * and read in the right order by a screen reader — and it means the section
 * renders correctly when the motion island never boots.
 *
 * The section's top edge is a straight line. The client's earlier mockup had a
 * wavy divider here and asked explicitly for it to go.
 */

const words = (text: string) => text.split(/\s+/).filter(Boolean);
---

<section class="story u-on-cream" id="story" aria-labelledby="story-title" data-story>
  <div class="story__stage">
    <div class="story__art story__art--left" aria-hidden="true">
      <ReefArtwork side="left" />
    </div>
    <div class="story__art story__art--right" aria-hidden="true">
      <ReefArtwork side="right" />
    </div>

    <div class="story__window" data-story-window>
      <div class="story__passage" data-story-track>
        {
          site.story.paragraphs.map((paragraph, index) => {
            const Tag = index === 0 ? 'h2' : 'p';
            return (
              <Tag
                class="story__para u-display"
                id={index === 0 ? 'story-title' : undefined}
              >
                {words(paragraph).map((word) => (
                  <>
                    <span class="story__word" data-story-word>
                      {word}
                    </span>{' '}
                  </>
                ))}
              </Tag>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    /* Straight top edge — no wavy divider. */
  }

  /*
   * The scroll distance the passage travels over. Only meaningful once the
   * island has pinned the stage; without it the section is its natural height.
   */
  .story[data-story-pinned='true'] {
    height: 148svh;
  }

  .story__stage {
    display: grid;
    place-items: center;
    padding-block: var(--space-2xl);
    padding-inline: var(--gutter);
    overflow: clip;
    isolation: isolate;
  }

  .story[data-story-pinned='true'] .story__stage {
    position: sticky;
    inset-block-start: 0;
    height: 100svh;
    padding-block: 0;
  }

  /**
   * The window the passage moves through.
   *
   * Its height is fixed only once the island is driving the travel. Without
   * JavaScript a fixed height would simply clip the writing and there would be
   * nothing to scroll it — so by default it is whatever the passage needs.
   */
  .story__window {
    width: 100%;
    max-width: min(100%, 44rem);
  }

  .story[data-story-pinned='true'] .story__window {
    height: clamp(19rem, 58svh, 34rem);
    overflow: clip;
    /* Text arrives and leaves rather than being cut off at a hard edge. */
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 14%,
      black 86%,
      transparent 100%
    );
  }

  .story__passage {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    text-align: center;
    will-change: transform;
  }

  /*
   * Both paragraphs, identically set. The first is an h2 for the document
   * outline — it is the section's heading in structure — but nothing about its
   * appearance says so, because visually it is simply where the passage starts.
   */
  .story__para {
    font-size: var(--step-3);
    line-height: 1.28;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  /**
   * The starting colour is full navy, not the faded aqua.
   *
   * That matters: if the island never boots, or the visitor has reduced motion
   * on, every word stays at full contrast and the passage is completely
   * legible. The animation's job is to fade words *away* behind the reader, not
   * to fade them in — so the accessible state is also the default state.
   */
  .story__word {
    color: var(--navy);
    transition: color 0.1s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .story__word {
      color: var(--navy) !important;
    }
  }

  .story__art {
    position: absolute;
    inset-block-end: 0;
    z-index: -1;
    width: clamp(13rem, 30vw, 34rem);
    height: min(100%, 46rem);
    pointer-events: none;
  }

  .story__art--left {
    inset-inline-start: 0;
  }

  .story__art--right {
    inset-inline-end: 0;
  }

  @media (max-width: 52rem) {
    .story__art {
      width: 42vw;
      height: 12rem;
      opacity: 0.6;
    }
  }
</style>
